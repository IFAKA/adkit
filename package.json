{
  "name": "adkit",
  "version": "0.1.0",
  "description": "Make professional motion-design product ad videos for any app. A deterministic engine does the repeated work; an AI agent (or a human) only writes one spec file.",
  "keywords": ["video", "ad", "remotion", "product-video", "app-store", "motion-design", "ai-agent", "playwright", "deterministic", "cli"],
  "homepage": "https://github.com/IFAKA/adkit",
  "repository": {"type": "git", "url": "git+https://github.com/IFAKA/adkit.git"},
  "bugs": {"url": "https://github.com/IFAKA/adkit/issues"},
  "license": "MIT",
  "author": "Facundo Arenas",
  "type": "module",
  "bin": {"adkit": "bin/adkit.mjs"},
  "files": ["bin", "src", "audio", "skills", "schema", "examples", "README.md", "LICENSE"],
  "engines": {"node": ">=20"},
  "scripts": {
    "adkit": "node bin/adkit.mjs",
    "schema": "tsx src/spec/export-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "@remotion/cli": "4.0.539",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
